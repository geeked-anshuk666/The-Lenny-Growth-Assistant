# ─── Lenny Growth Assistant — Environment Variables Template ─────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.

# ─── Database ────────────────────────────────────────────────────────────────
# NeonDB connection string (get from https://neon.tech → your project → Connection details)
# Format: postgresql+asyncpg://<user>:<password>@<host>/<db>?sslmode=require
NEON_DATABASE_URL=your_neon_database_url_here

# ─── Cloud LLM Providers ─────────────────────────────────────────────────────
# Google AI Studio (free tier, no card required — https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the default Gemini model (default: gemini-2.0-flash-lite)
GEMINI_MODEL=gemini-2.0-flash-lite

# Groq (free tier, no card required — https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the default Groq model (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# ─── Local LLM (Ollama) ──────────────────────────────────────────────────────
# Ollama must run as a host-level process (ollama serve).
# Use host.docker.internal:11434 when running inside Docker containers.
# Use localhost:11434 when running services locally (npm run dev).
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Pull this model first: ollama pull qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b

# ─── Provider Selection ───────────────────────────────────────────────────────
# Which provider to use by default (options: gemini, groq, ollama)
LLM_PROVIDER=gemini
# Fallback provider if the primary fails or is rate-limited
LLM_PROVIDER_FALLBACK=ollama
